# Salin file ini menjadi .env dan isi sesuai lingkungan.
# .env TIDAK PERNAH di-commit — lihat .gitignore.

# --- Develop / test (Postgres lokal via Docker) ---
# npm run db:up membuat container "ottodot-postgres" pada port 5433.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/ottodot?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/ottodot?schema=public"

# --- Produksi / demo (Supabase) — isi saat deploy ---
# DATABASE_URL="postgresql://postgres.<project>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<project>:<password>@<direct-host>:5432/postgres"

# Wajib eksplisit "true" agar endpoint demo (/api/demo/parents) aktif.
DEMO_MODE="true"
